      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportEcommerce.Application\SportEcommerce.Application.csproj" />
    <ProjectReference Include="..\SportEcommerce.Infrastructure\SportEcommerce.Infrastructure.csproj" />
  </ItemGroup>

</Project>
